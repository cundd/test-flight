{
    "name": "cundd/test-flight",
    "description": "Test runner for inline unit tests",
    "type": "library",
    "keywords": [
        "testing"
    ],
    "homepage": "https://test-flight.cundd.net",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Corn",
            "email": "info@cundd.net"
        }
    ],
    "bin": [
        "bin/test-flight"
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-pcre": "*",
        "ext-reflection": "*",
        "ext-tokenizer": "*",
        "ext-spl": "*"
    },
    "require-dev": {
        "phpspec/prophecy": "^1.3.1"
    },
    "autoload": {
        "psr-4": {
            "Cundd\\TestFlight\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "suggest": {
        "phpspec/prophecy": "PHP object mocking framework",
        "phpunit/phpunit": "More assert methods and separate Unit tests"
    },
    "support": {
        "issues": "https://github.com/cundd/test-flight/issues"
    }
}
